---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">
      {{ page.type }}
      {% if page.venue %} @ {{ page.venue }}{% endif %}
    </p>
    <p class="post-meta">
      <i class="fa-solid fa-calendar fa-sm"></i> {{ page.date | date: '%B %Y' }}
      {% if page.location %} &nbsp; &middot; &nbsp; <i class="fa-solid fa-location-dot fa-sm"></i> {{ page.location }}{% endif %}
      {% if page.slides %} &nbsp; &middot; &nbsp; <a href="{{ page.slides | relative_url }}"><i class="fa-solid fa-file-powerpoint fa-sm"></i> Slides</a>{% endif %}
    </p>
  </header>

  <article>
    {{ content }}
  </article>
</div>
